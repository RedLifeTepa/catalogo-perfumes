// AuraERP v1.7.0 - Security hardening
rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){ return request.auth != null; }
  function hasProfile(){ return signedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)); }
  function me(){ return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
  function active(){ return hasProfile() && me().activo == true; }
  function admin(){ return active() && me().rol == "admin"; }
  function supervisor(){ return active() && me().rol == "supervisor"; }
  function seller(){ return active() && (me().rol=="vendedor" || admin() || supervisor()); }
  function collector(){ return active() && (me().rol=="cobrador" || seller()); }

  match /usuarios/{uid}{
   allow read: if signedIn() && (request.auth.uid==uid || admin());
   allow create: if signedIn() && request.auth.uid==uid
     && request.resource.data.uid == request.auth.uid
     && request.resource.data.rol == "consulta"
     && request.resource.data.activo == true;
   allow update: if admin()
     && (uid != request.auth.uid || request.resource.data.activo == true);
   allow delete: if false;
  }

  match /configuracion/{id}{
   allow read: if id=="empresa" || active();
   allow create,update: if admin();
   allow delete: if false;
  }

  match /categorias/{id}{
   allow read: if true;
   allow create,update: if admin() || supervisor();
   allow delete: if false;
  }

  match /productos/{id}{
   allow read: if true;
   allow create: if admin() || supervisor();
   allow update: if admin() || supervisor()
     || (!signedIn()
       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["numeroVistas"])
       && request.resource.data.numeroVistas is int
       && request.resource.data.numeroVistas == resource.data.numeroVistas + 1);
   allow delete: if false;
  }

  match /clientes/{id}{
   allow read: if active();
   allow create,update: if seller() || collector();
   allow delete: if false;
  }

  match /pedidos/{id}{
   allow create: if request.resource.data.keys().hasOnly(["folio","clienteID","clienteNombre","telefono","correo","estado","productos","subtotal","total","canal","origen","createdAt"])
     && request.resource.data.clienteID == null
     && request.resource.data.estado == "nuevo"
     && request.resource.data.canal == "catalogo_web"
     && request.resource.data.origen == "index"
     && request.resource.data.clienteNombre is string
     && request.resource.data.clienteNombre.size() >= 2
     && request.resource.data.telefono is string
     && request.resource.data.telefono.size() >= 7
     && request.resource.data.productos is list
     && request.resource.data.productos.size() > 0
     && request.resource.data.total is number
     && request.resource.data.total > 0;
   allow read: if active();
   allow update: if seller();
   allow delete: if false;
  }

  match /ventas/{id}{
   allow read: if active();
   allow create: if seller();
   allow update: if collector();
   allow delete: if false;
  }

  match /abonos/{id}{
   allow read: if active();
   allow create: if collector() && request.resource.data.monto is number && request.resource.data.monto > 0;
   allow update: if admin();
   allow delete: if false;
  }

  match /tareasCRM/{id}{
   allow read: if active();
   allow create,update: if seller() || supervisor() || admin();
   allow delete: if false;
  }

  match /movimientosInventario/{id}{
   allow read: if active();
   allow create: if seller() || admin() || supervisor();
   allow update: if admin();
   allow delete: if false;
  }

  match /respaldos/{id}{
   allow read,create: if admin();
   allow update,delete: if false;
  }

  match /notificaciones/{id}{
   allow read: if active();
   allow create,update: if admin() || supervisor();
   allow delete: if false;
  }

  match /bitacora/{id}{
   allow create: if active();
   allow read: if admin();
   allow update: if admin();
   allow delete: if false;
  }

  match /{document=**}{ allow read,write: if false; }
 }
}